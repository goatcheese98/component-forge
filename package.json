{
  "name": "component-forge",
  "version": "1.0.0",
  "description": "A comprehensive Tailwind CSS and DaisyUI component design system with testing laboratory",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:lib": "vite build --mode lib && vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "node --experimental-strip-types node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config .",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run build:lib",
    "check:lib": "npm run build:lib && tsc -p tests/consumer/tsconfig.json && node tests/verify-library.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.46",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-tsc": "^3.0.3"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "keywords": [
    "vue3",
    "tailwindcss",
    "daisyui",
    "design-system",
    "components",
    "ui-library",
    "testing-toolkit"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goatcheese98/component-forge.git"
  }
}
