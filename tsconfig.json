{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "daisy-ui-lab/**/*",
    "tests/**/*.ts",
    "eslint.config.ts"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "tests/consumer"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ]
    },
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  }
}
