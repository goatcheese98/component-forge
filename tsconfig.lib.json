{
  "extends": "./tsconfig.json",
  "include": [
    "env.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "composite": false
  }
}
